{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "GPT: train",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["gpt-train"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "GPT: quick train (small, CPU)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["gpt-train", "--max-iters", "500", "--n-layer", "2", "--n-embd", "64", "--n-head", "4", "--eval-iters", "20"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "GPT: generate",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["gpt-generate", "--chars", "500"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Sentiment: train",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["sentiment-train"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Sentiment: chat",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["chat"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
